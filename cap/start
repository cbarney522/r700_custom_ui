#!/bin/bash
# custom_ui_cap — entry point run by the Impinj R700 at boot.
# The CAP is mounted read-only at /cust; only /cust/rw_dir is writable
# (see input_manifest.json). Like replenibin, this script runs in the
# foreground forever and supervises the web UI server.
#
# Author: Clifford Barney

CAP_ROOT="$(cd "$(dirname "$0")" && pwd)"
[ -f "$CAP_ROOT/app.env" ] && . "$CAP_ROOT/app.env"
UI_PORT="${UI_PORT:-8443}"
RW="$CAP_ROOT/rw_dir"
LOG_DIR="$RW/log"
LOG="$LOG_DIR/ui.log"
mkdir -p "$LOG_DIR"

export CAP_DATA_DIR="$RW"
export PYTHONDONTWRITEBYTECODE=1    # never write .pyc into the read-only partition

# ---- startup diagnostics: answers "what does this reader's CAP runtime have?"
{
  echo "custom_ui_cap diagnostics  $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  echo "kernel:  $(uname -a)"
  [ -f /etc/os-release ] && grep -E '^(NAME|VERSION)=' /etc/os-release
  echo "cap_root: $CAP_ROOT"
  echo "glibc:   $(getconf GNU_LIBC_VERSION 2>/dev/null || ldd --version 2>&1 | head -1)"
  if [ -x "$CAP_ROOT/python/bin/python3" ]; then
    echo "bundled python: $("$CAP_ROOT/python/bin/python3" -c 'import sys,ssl; print(sys.version.split()[0], "|", ssl.OPENSSL_VERSION)' 2>&1)"
  else
    echo "bundled python: NOT PRESENT"
  fi
  echo "libgcc_s: $(ls /lib/libgcc_s.so.1 /usr/lib/libgcc_s.so.1 "$CAP_ROOT/python/lib/libgcc_s.so.1" 2>/dev/null | tr '\n' ' ')"
  for t in python3 python openssl curl busybox bash; do
    p="$(command -v "$t" 2>/dev/null)"; echo "$t: ${p:-NOT FOUND}"
  done
  echo "rw_dir writable: $( (touch "$RW/.probe" && rm -f "$RW/.probe" && echo yes) 2>/dev/null || echo NO)"
  df -h "$CAP_ROOT" "$RW" 2>/dev/null
} > "$RW/diag.txt" 2>&1
cat "$RW/diag.txt"

# Prefer the Python bundled in the CAP; fall back to a system python3 if one exists.
PY=""
if "$CAP_ROOT/python/bin/python3" -c 'import ssl' >/dev/null 2>&1; then
  PY="$CAP_ROOT/python/bin/python3"
elif command -v python3 >/dev/null; then
  PY="$(command -v python3)"
fi
if [ -z "$PY" ]; then
  echo "custom_ui_cap: no working python3 (bundled or system)."
  # Fallback so diag.txt can still be read from a browser: http://<reader>:$UI_PORT/diag.txt
  if command -v busybox >/dev/null && busybox --list 2>/dev/null | grep -qx httpd; then
    mkdir -p "$RW/diag_www" && cp "$RW/diag.txt" "$RW/diag_www/"
    exec busybox httpd -f -p "$UI_PORT" -h "$RW/diag_www"
  fi
  while true; do sleep 3600; done     # stay alive; diagnostics are in the log
fi

# ---- supervisor loop: restart the server if it exits
while true; do
  "$PY" "$CAP_ROOT/app/server.py" --port "$UI_PORT" --data-dir "$RW" >> "$LOG" 2>&1
  echo "$(date) server exited ($?); restarting in 5 s" >> "$LOG"
  if [ "$(wc -c < "$LOG")" -gt 1048576 ]; then
    tail -c 262144 "$LOG" > "$LOG.1" && mv "$LOG.1" "$LOG"
  fi
  sleep 5
done
